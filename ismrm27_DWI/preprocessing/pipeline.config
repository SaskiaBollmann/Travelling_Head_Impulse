# ======================================================================
# pipeline.config
# ---------------
# This pipeline is configured for the Travelling brain 2026 project,
# comparison between MAGDEBURG and STANFORD acquisitions
#
# Author:   Daniel Uher
# Email:    daniel.uher@ovgu.de
# Version:  0.1.0
# ======================================================================


# ======================================================================
# ---- Step directories ----
# ======================================================================
# Specify which steps should be run (without .sh extension).
# Each step is a bash script which is in the same folder as the
# run_pipeline.sh script. I aimed with this setup to make it easy
# to adapt to your pipeline needs.
STEPS=( init denoise degibbs prefsl synbo eddy gnc_dwi bias gnc_t1w )

# from which step should the pipeline start. For instance START_STEP="degibbs"
# will skip all the step before and start from degibbs.sh. You need to make sure
# that all the files for topup are available already.


# ======================================================================
# ---- Subject / session ----
# ======================================================================
SUB=sub-01 # set before execution
# SESS=sess-MGDB01


# ======================================================================
# ---- DWI acquisition parameters ----
# ======================================================================
ACQ='ep2d'                                  # acquisition identifier
DIRS=( 'AP' 'PA' )                          # phase encoding directions
DIR1="0 -1 0"                               # code for the first direction
DIR2="0 1 0"                                # code for the second dir
BVALS=( 'b1k' 'b2p5k' )                     # bvalues acquired separately
PARTS=( 'mag' )                             # which parts are available
TOTAL_READOUT_TIME=0.0212                   # can be obtained from .json


# ======================================================================
# ---- T1w acquisition parameters ----
# ======================================================================
MODE='PS'            # patient specific
IMTYPE='UNI'         # use the uni denoised with no distortion correction

# ======================================================================
# ---- Paths ----
# ======================================================================
DATADIR=... # path to your data (e.g. BIDS) directory

DWIDIR=${DATADIR}/${SUB}/${SESS}/dwi    # path to the dwi data directory
ANATDIR=${DATADIR}/${SUB}/${SESS}/anat  # path to the anat data directory
FMAPDIR=${DATADIR}/${SUB}/${SESS}/fmap  # path to the fmap data directory
OUTDIR=${DATADIR}/${SUB}/${SESS}/proc   # final output directory

SYNBO_INPUTS=.../synbo-disco/INPUTS       # path to the input directory for SynB0-Disco
SYNBO_OUTPUTS=.../synbo-disco/OUTPUTS     # path to the output directory for SynB0-Disco

WORKDIR=${OUTDIR}/steps         # working directory
INITDIR=${WORKDIR}/init         # stores the unprocessed input data
LOGDIR=${OUTDIR}/logs           # logging directory

T1W=${ANATDIR}/${SUB}_${SESS}_acq-MP2RAGE_mode-${MODE}_desc-${IMTYPE}.nii  # path to the T1w

# B0 mapping
# B0=${FMAPDIR}/${SUB}_${SESS}_acq-gre_desc-ND_b0map.nii  # path to b0 map
# B0e1=${FMAPDIR}/${SUB}_${SESS}_acq-gre_echo-1_desc-ND.nii # echo 1 of B0 map seq
# B0e2=${FMAPDIR}/${SUB}_${SESS}_acq-gre_echo-1_desc-ND.nii # echo 2 of B0 map seq

# Output prefix
FINAL_OUTPREFIX=${SUB}_acq-${ACQ}_preprocessed   # output prefix for preprocessed files


# ======================================================================
# ---- Environment / containers ----
# ======================================================================
NTHREADS=16              # Number of threads for threaded applications
FSLOUTPUTTYPE=NIFTI     # FSL will save everything as .nii instead .nii.gz
MRTRIX_QUIET=1          # comment out if you want output messages from mrtrix commands
DELETE_STEPS=false       # whether to keep or delete all preprocessing intermediary outputs


# ======================================================================
# ---- Containers ----
# ======================================================================
MRTRIX_CONTAINER=.../Containers/mrtrix3.sif     # path to mrtrix .sif container
FREESURFER_CONTAINER=.../Containers/freesurfer_8.2.0.sif # path to freesurfer .sif container
ANTS_CONTAINER=.../Containers/ants_2.6.3.sif # path to ANTs .sif container
DWIDENOISE2_CONTAINER=.../Containers/dwidenoise2_20260603.sif # path to DWIDENOISE2 latest container
SYNBODISCO_CONTAINER=.../Containers/synbo-disco_3.1.sif # path to synb0-disco latest container


# ======================================================================
# ---- Scanner-specific settings ----
# ======================================================================
TOPUP_CONFIG=b02b0_7Tx.cnf  # config file for topup
SCANNER=7Tx                 # option either '7Tx' or '7Tplus'
GNC_INTERP_ORDER=3          # order of interpolation (use >1 for publication results - recommended 3)


# ======================================================================
# ---- safety guards ----
# ======================================================================
# prevent direct execution
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "ERROR: pipeline.config must be sourced, not executed."
    exit 1
fi
